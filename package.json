{
  "name": "knowmesh",
  "type": "module",
  "scripts": {
    "postinstall": "node scripts/prepare-excalidraw-assets.ts",
    "dev:next": "next dev",
    "dev": "node scripts/local-runtime.ts dev",
    "build:next": "next build",
    "build-local": "node scripts/local-runtime.ts build-local",
    "build": "npm run build:next",
    "collaboration": "tsx --env-file=.env scripts/collaboration-server.ts",
    "collaboration:prepare": "tsx --env-file=.env scripts/collaboration-server.ts --prepare",
    "whiteboard:collaboration": "tsx --env-file=.env scripts/whiteboard-collaboration-server.ts",
    "whiteboard:collaboration:prepare": "tsx --env-file=.env scripts/whiteboard-collaboration-server.ts --prepare",
    "start": "next start",
    "clean": "rimraf .next out coverage",
    "codegraph:watch": "node scripts/codegraph-watch.ts",
    "lint": "ultracite check --type-aware --type-check",
    "lint:fix": "ultracite fix --type-aware --type-check",
    "check:types": "tsc --noEmit --pretty",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "dotenv -c -- drizzle-kit migrate",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@excalidraw/excalidraw": "0.18.1",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/noto-sans-sc": "^5.3.0",
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@hocuspocus/extension-database": "^4.7.0",
    "@hocuspocus/provider": "^4.7.0",
    "@hocuspocus/provider-react": "^4.7.0",
    "@hocuspocus/server": "^4.6.0",
    "@hocuspocus/transformer": "^4.7.0",
    "@react-email/components": "^1.0.12",
    "@t3-oss/env-nextjs": "^0.13.11",
    "@tiptap/core": "^3.31.3",
    "@tiptap/extension-collaboration": "^3.31.3",
    "@tiptap/extension-collaboration-caret": "^3.31.3",
    "@tiptap/pm": "^3.31.3",
    "@tiptap/react": "^3.31.3",
    "@tiptap/starter-kit": "^3.31.3",
    "@tiptap/y-tiptap": "^3.0.9",
    "better-auth": "^1.7.6",
    "drizzle-orm": "^0.45.3",
    "lucide-react": "^1.48.0",
    "next": "^16.3.6",
    "pg": "^8.23.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "resend": "^6.30.0",
    "socket.io": "4.8.4",
    "socket.io-client": "4.8.4",
    "y-indexeddb": "^9.0.12",
    "y-protocols": "^1.0.7",
    "yjs": "^13.6.33",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@electric-sql/pglite-socket": "^0.2.11",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^25.9.8",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^4.1.11",
    "babel-plugin-react-compiler": "^1.0.0",
    "dotenv": "^17.4.2",
    "dotenv-cli": "^11.0.0",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.28.2",
    "fake-indexeddb": "^6.2.5",
    "lefthook": "^2.1.14",
    "npm-run-all": "^4.1.5",
    "oxfmt": "^0.70.0",
    "oxlint": "^1.85.0",
    "oxlint-tsgolint": "^0.25.0",
    "rimraf": "^6.1.3",
    "tailwindcss": "^4.3.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "ultracite": "^7.12.1",
    "vitest": "^4.1.7"
  },
  "engines": {
    "node": ">=24"
  },
  "postcss": {
    "plugins": {
      "@tailwindcss/postcss": {}
    }
  }
}
