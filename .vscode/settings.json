{
  "editor.tabSize": 2,
  "editor.detectIndentation": false,
  "search.exclude": {
    "package-lock.json": true
  },

  // TypeScript
  "js/ts.tsdk.path": "node_modules/typescript/lib", // Use the workspace version of TypeScript
  "js/ts.tsdk.promptToUseWorkspaceVersion": true, // For security reasons it's require that users opt into using the workspace version of typescript
  "js/ts.preferences.autoImportSpecifierExcludeRegexes": [
    // Use App Router navigation APIs instead of the legacy Pages Router
    "next/router",
    // give priority for Link to next/link instead of lucide-react
    "lucide-react",
    // Not used in the project and conflicts with `use()` from React
    "chai",
    // Use Zod v4 instead of v3
    "zod/v3",
    // Do not auto-import from postcss
    "postcss"
  ],

  // Vitest
  "testing.automaticallyOpenTestResults": "neverOpen", // Don't open the test results automatically

  // Oxc
  "editor.defaultFormatter": "oxc.oxc-vscode",
  "editor.formatOnSave": true,
  "editor.formatOnSaveMode": "file", // Tell oxfmt to format the whole file, not only the modified lines
  "oxc.typeAware": true, // Enable type-aware linting

  // Auto fix on save
  "editor.codeActionsOnSave": {
    "source.addMissingImports": "explicit",
    "source.fixAll.oxc": "explicit"
  }
}
