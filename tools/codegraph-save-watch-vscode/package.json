{
  "name": "codegraph-save-watch",
  "displayName": "CodeGraph Save Watch",
  "version": "0.1.1",
  "description": "Runs a workspace command when files in configured folders are saved.",
  "categories": [
    "Other"
  ],
  "keywords": [
    "codegraph",
    "save",
    "watch"
  ],
  "license": "MIT",
  "publisher": "local",
  "main": "./extension.cjs",
  "contributes": {
    "commands": [
      {
        "command": "codegraphSaveWatch.showOutput",
        "title": "CodeGraph Save Watch: Show Output"
      }
    ]
  },
  "activationEvents": [
    "workspaceContains:codegraph.watch.json"
  ],
  "extensionKind": [
    "workspace"
  ],
  "engines": {
    "vscode": "^1.85.0"
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "The extension executes the command configured by the workspace."
    }
  }
}
